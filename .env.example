# Local development only. Replace the database password before shared use.
POSTGRES_USER=hub
POSTGRES_PASSWORD=local-development-only
POSTGRES_DB=hub
HUB_DATABASE_URL=postgresql+psycopg://hub:local-development-only@127.0.0.1:5432/hub
HUB_PUBLIC_ORIGIN=http://localhost:3000
HUB_COOKIE_SECURE=false
HUB_SESSION_HOURS=12
# Next.js server-only variable; never expose credentials via NEXT_PUBLIC_.
HUB_API_URL=http://127.0.0.1:8000
